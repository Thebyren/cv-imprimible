---
import Layout from "@/layouts/layout.astro"
import About from "components/sections/About.astro"
import Education from "components/sections/Education.astro"
import Hero from "components/sections/Hero.astro"
import KeyboardManager from "@/components/KeyboardManager.astro"
import Projects from "components/sections/Projects.astro"
import Skills from "components/sections/Skills.astro"
import Experience from "components/sections/Experience.astro"
import Link from "components/sections/Link.astro"
import {basics} from "@/cv.json"
const {name, label} = basics
---

<Layout title=`${name} · CV`>

  <!-- ── canvas de fondo (toda la página, solo web) ── -->
  <canvas id="bg-canvas" aria-hidden="true" style="position:fixed;inset:0;pointer-events:none;z-index:0;display:block;"></canvas>

  <!-- ── chrome de página (solo web) ───────────────── -->
  <div class="chrome" aria-hidden="true">
    <span class="doc-id">CV.BPF-01 · REV. 2026</span>
    <span class="signal">
      <span class="dot"></span>
      SEÑAL ACTIVA
    </span>
  </div>

  <!-- ── sidebar lateral (solo web) ───────────────── -->
  <aside class="sidebar" aria-hidden="true">
    <span class="sid-text">BYRON PASTOR · 14.2915°N 89.8956°W · JUTIAPA GT</span>
  </aside>

  <!-- ── contenido principal ───────────────────────── -->
  <main>
    <Hero/>
    <Experience/>
    <Projects/>
    <About/>
    <Skills/>
    <Education/>
    <div class="print-link"><Link/></div>
  </main>

  <KeyboardManager/>

</Layout>

<script>
(function () {
  const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d')!;

  const STEP  = 22;    // grid spacing px
  const R0    = 0.85;  // base dot radius
  const R1    = 3.5;   // max radius near mouse
  const SIGMA = 100;   // gaussian spread
  const A0    = 0.07;  // base opacity
  const A1    = 0.58;  // mouse-boost opacity
  const FLICK = 0.5;   // flicker amplitude
  const DAMP  = 0.22;  // hero zone dampen factor

  let mx = -9999, my = -9999;
  let heroRect: DOMRect | null = null;

  function resize() {
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  // track hero rect (updates on scroll + resize)
  function updateHeroRect() {
    const hero = document.querySelector('.hero') as HTMLElement;
    heroRect = hero ? hero.getBoundingClientRect() : null;
  }
  updateHeroRect();
  window.addEventListener('scroll', updateHeroRect, { passive: true });
  window.addEventListener('resize', updateHeroRect);

  window.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
  window.addEventListener('mouseleave', () => { mx = -9999; my = -9999; });

  function inHero(x: number, y: number) {
    if (!heroRect) return false;
    return x >= heroRect.left && x <= heroRect.right &&
           y >= heroRect.top  && y <= heroRect.bottom;
  }

  function draw(t: number) {
    const sec = t * 0.001;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const cols = Math.ceil(canvas.width  / STEP) + 1;
    const rows = Math.ceil(canvas.height / STEP) + 1;

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const x = c * STEP;
        const y = r * STEP;

        const hero = inHero(x, y);

        const dx = x - mx, dy = y - my;
        const g  = Math.exp(-(dx*dx + dy*dy) / (2 * SIGMA * SIGMA));

        const flicker = 0.5 + FLICK * Math.sin(sec * 1.4 + c * 0.53 + r * 0.79);

        const dampen  = hero ? DAMP : 1.0;
        const radius  = R0 + (R1 - R0) * g * (hero ? 0.4 : 1.0);
        const opacity = (A0 * flicker + A1 * g) * dampen;

        ctx.beginPath();
        ctx.arc(x, y, radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(43,92,255,${opacity.toFixed(3)})`;
        ctx.fill();
      }
    }

    requestAnimationFrame(draw);
  }

  requestAnimationFrame(draw);
})();
</script>

<style>

  /* ── chrome ──────────────────────────────────────── */
  .chrome {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem 0 2.5rem;
    border-bottom: 1px solid var(--border);
    background: rgba(8,9,13,0.92);
    backdrop-filter: blur(8px);
    z-index: 100;
    font-family: var(--mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .signal {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--ok);
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ok);
    animation: pulse 2s ease-in-out infinite;
  }

  /* ── sidebar ─────────────────────────────────────── */
  .sidebar {
    position: fixed;
    top: 28px;
    left: 0;
    bottom: 0;
    width: 24px;
    border-right: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
  }

  .sid-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--mono);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    user-select: none;
    white-space: nowrap;
  }

  /* ── canvas de fondo ────────────────────────────── */
  #bg-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  /* ── main ────────────────────────────────────────── */
  main {
    position: relative;
    z-index: 1;
    margin-top: 28px;
    margin-left: 24px;
    padding: 24px 20px 60px;
  }

  .print-link { display: none; }

  /* ── print ───────────────────────────────────────── */
  @media print {
    .chrome, .sidebar { display: none; }
    main {
      margin: 0;
      padding: 10px 8px 0;
    }
    .print-link { display: block; }
  }

</style>
