---
import Section from "components/section.astro";
import { work } from "@/cv.json";
---

<Section title="Historial Operativo">
  <ul>
    {
      work.map(({ name, position, url, startDate, endDate, summary }) => {
        const sy = new Date(startDate+'T00:00:01Z').getFullYear();
        const ey = endDate ? new Date(endDate+'T00:00:01Z').getFullYear() : "presente";
        const range = `${sy} — ${ey}`;
        const current = endDate === null;

        return (
          <li>
            <article class={current ? "current" : ""}>
              <header>
                <div class="title">
                  <h3>{name}</h3>
                  <h4>{position}</h4>
                </div>
                <date>{range}</date>
              </header>
              <p>
                {summary}
                {url && <> · <a href={url} target="_blank">ver más →</a></>}
              </p>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul { display: flex; flex-direction: column; gap: 0; }

  li + li { border-top: 1px solid var(--border); }

  article {
    padding: 1rem 0 1rem 1rem;
    border-left: 2px solid var(--border-2);
    margin-left: 2px;
    transition: border-color 0.15s;
  }

  article.current { border-left-color: var(--ok); }

  article:hover { border-left-color: var(--accent); }

  li:first-child article { padding-top: 0; }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }

  h3 {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  h4 {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--ink-2);
    margin-top: 2px;
  }

  a { color: var(--accent-hi); font-size: 0.8rem; }
  a:hover { text-decoration: underline; }

  @media print {
    article { padding: 0.65rem 0 0.65rem 0.9rem; }
    li:first-child article { padding-top: 0; }
    article.current { border-left-color: #157a44; }
  }
</style>
