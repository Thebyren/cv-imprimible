---
import Section from "components/section.astro";
import { work } from "@/cv.json";
---

<Section title="Experience">
  <ul>
    {
      work.map(({ name, position, url, startDate, endDate, summary }) => {
        const StartYear = new Date(startDate+'T00:00:01Z').getFullYear();
        const EndYear = endDate !== null ? new Date(endDate+'T00:00:01Z').getFullYear() : "presente";
        const Years = `${StartYear} — ${EndYear}`;

        return (
          <li>
            <article>
              <header>
                <div class="title-block">
                  <h3>{name}</h3>
                  <h4>{position}</h4>
                </div>
                <date>{Years}</date>
              </header>
              <p>
                {summary}
                {url && (
                  <> · <a href={url} target="_blank">ver más →</a></>
                )}
              </p>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  li + li {
    border-top: 1px solid var(--border);
  }

  article {
    padding: 1rem 0;
    padding-left: 0.75rem;
    border-left: 2px solid var(--border);
    margin-left: 0.25rem;
    transition: border-color 0.15s ease-out;
  }

  article:hover {
    border-left-color: var(--accent);
  }

  li:first-child article {
    padding-top: 0;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }

  h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  h4 {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-secondary);
    margin-top: 1px;
  }

  a {
    color: var(--accent);
    font-size: 0.8rem;
  }

  a:hover {
    text-decoration: underline;
  }

  @media print {
    article {
      padding: 0.7rem 0 0.7rem 0.75rem;
    }
    li:first-child article {
      padding-top: 0;
    }
  }
</style>
