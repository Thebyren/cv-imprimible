---
import { basics } from "@/cv.json";
import Mail from "@/icons/mail.astro";
import Phone from "@/icons/phone.astro";
import X from "@/icons/X.astro";
import Linkedin from "@/icons/Linkedin.astro";
import Github from "@/icons/Github.astro";
import WorlMap from "@/icons/WorlMap.astro";
import Section from "@/components/section.astro";
import type { SocialIcon } from "@/types";
const { name, label, image, location, profiles, phone, email } = basics;
const { city, region } = location;
const Linkedininfo = profiles.find(({network})=> network ==="Linkedin")

const SOCIAL_ICONS: SocialIcon = {
  Github,
  Linkedin,
  X,
};

const printInfo = [Linkedininfo?.url, email, phone].filter(Boolean).join("  ·  ")
---

<Section>
  <div class="container">
    <div class="info">
      <div class="meta">
        <span class="meta-tag">
          <WorlMap/>
          {city}, {region}
        </span>
      </div>
      <h1>{name}</h1>
      <h2>{label}</h2>

      <div class="print-info">
        <p>{printInfo}</p>
      </div>

      <footer class="non-print">
        {
          email && (
            <a
              href={`mailto:${email}`}
              title={`Enviar correo a ${name}`}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
            >
              <Mail />
              <span>{email}</span>
            </a>
          )
        }
        {
          phone && (
            <a
              href={`tel:+${phone}`}
              title={`Llamar a ${name}`}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
            >
              <Phone />
              <span>{phone}</span>
            </a>
          )
        }
        {
          profiles.map(({ network, username, url }) => {
            const Icon_ = SOCIAL_ICONS[network];
            return (
              <a
                href={url}
                title={`Perfil de ${name} en ${network}`}
                target="_blank"
                rel="noopener noreferrer"
                class="icon-link"
              >
                <Icon_ />
              </a>
            );
          })
        }
      </footer>
    </div>
    <figure>
      <img src={image} alt={name} />
    </figure>
  </div>
</Section>

<style>
  .container {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }

  .meta-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-tertiary);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  h1 {
    font-size: 1.9rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  h2 {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink-secondary);
    letter-spacing: -0.01em;
  }

  figure {
    flex-shrink: 0;
  }

  img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 90px;
    border-radius: var(--radius);
    border: 2px solid var(--accent);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 0.4rem;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-secondary);
    border: 1px solid var(--border-hard);
    padding: 4px 10px;
    border-radius: var(--radius);
    transition: all 0.15s ease-out;
    letter-spacing: 0.01em;
  }

  .contact-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-subtle);
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-tertiary);
    border: 1px solid var(--border-hard);
    padding: 4px;
    height: 28px;
    width: 28px;
    border-radius: var(--radius);
    transition: all 0.15s ease-out;
  }

  .icon-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-subtle);
  }

  .print-info {
    display: none;
    margin-top: 0.3rem;
  }

  .print-info p {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-secondary);
    letter-spacing: 0.02em;
  }

  @media print {
    .non-print { display: none; }
    .print-info { display: block; }
    img { width: 80px; border: 1px solid var(--border-hard); }
    h1 { font-size: 1.6rem; }
  }
</style>
