---
import Section from "components/section.astro";
import { projects } from "@/cv.json";
---

<Section title="Projects">
  <ul>
    {
      projects.map(({ name, description, highlights, active, url }) => {
        return (
          <li>
            <article>
              <header>
                <div class="title-row">
                  <h3>
                    <a href={url} title={`Ver proyecto ${name}`} target="_blank">
                      {name}
                    </a>
                  </h3>
                  <span class={`status ${active ? "active" : "inactive"}`}>
                    {active ? "activo" : "archivado"}
                  </span>
                </div>
                <p>{description}</p>
              </header>
              <footer>
                {highlights.map((highlight) => (
                  <span class="tag">{highlight}</span>
                ))}
              </footer>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px;
  }

  article {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    transition: border-color 0.15s ease-out, background 0.15s ease-out;
  }

  article:hover {
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  header {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  h3 {
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  h3 a {
    color: var(--ink);
    transition: color 0.15s ease-out;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .status {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 6px;
    border-radius: var(--radius);
    flex-shrink: 0;
  }

  .active {
    color: var(--status-ok);
    background: rgba(31, 163, 92, 0.1);
    border: 1px solid rgba(31, 163, 92, 0.25);
  }

  .inactive {
    color: var(--ink-tertiary);
    background: var(--bg);
    border: 1px solid var(--border);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--bg);
    color: var(--ink-tertiary);
    border: 1px solid var(--border);
    padding: 2px 8px;
    border-radius: var(--radius);
  }
</style>
