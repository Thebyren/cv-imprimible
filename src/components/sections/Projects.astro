---
import Section from "components/section.astro";
import { projects } from "@/cv.json";
---

<Section title="Proyectos">
  <ul>
    {
      projects.map(({ name, description, highlights, active, url }) => (
        <li>
          <article>
            <header>
              <div class="title-row">
                <h3>
                  <a href={url} target="_blank" rel="noopener">{name}</a>
                </h3>
                <span class={`badge ${active ? "active" : "archived"}`}>
                  {active ? "activo" : "archivado"}
                </span>
              </div>
              <p>{description}</p>
            </header>
            <footer>
              {highlights.map(h => <span class="tag">{h}</span>)}
            </footer>
          </article>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px;
  }

  article {
    border: 1px solid var(--border);
    border-top: 2px solid var(--border-2);
    border-radius: var(--r);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    background: var(--bg-elevated);
    transition: border-top-color 0.15s, background 0.15s;
  }

  article:hover {
    border-top-color: var(--accent);
    background: rgba(43,92,255,0.05);
  }

  header { flex: 1; display: flex; flex-direction: column; gap: 6px; }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  h3 {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  h3 a {
    color: var(--ink);
    transition: color 0.15s;
  }

  h3 a:hover { color: var(--accent-hi); }

  .badge {
    font-family: var(--mono);
    font-size: 0.58rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 7px;
    border-radius: var(--r);
    flex-shrink: 0;
  }

  .active {
    color: var(--ok);
    background: var(--ok-sub);
    border: 1px solid rgba(31,163,92,0.25);
  }

  .archived {
    color: var(--ink-3);
    background: transparent;
    border: 1px solid var(--border-2);
  }

  footer { display: flex; flex-wrap: wrap; gap: 4px; }

  .tag {
    font-family: var(--mono);
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-3);
    border: 1px solid var(--border-2);
    padding: 2px 8px;
    border-radius: var(--r);
  }

  @media print {
    article { background: #fff; border-color: rgba(10,11,15,0.12); border-top-color: rgba(10,11,15,0.2); }
    .active { color: #157a44; background: rgba(21,122,68,0.07); }
    .tag { color: #7a8090; border-color: rgba(10,11,15,0.18); }
  }
</style>
