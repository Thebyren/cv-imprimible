---
import Section from "components/section.astro";
import { education } from "@/cv.json";
---

<Section title="Education">
  <ul>
    {
      education.map(({ institution, url, area, studyType, startDate, endDate }) => {
        const StartYear = new Date(startDate).getFullYear();
        const EndYear = endDate != null ? new Date(endDate).getFullYear() : "presente";
        const Years = `${StartYear} — ${EndYear}`;
        return (
          <li>
            <article>
              <div class="main">
                <h3>
                  <a href={url} target="_blank" rel="noopener noreferrer">
                    {institution}
                  </a>
                </h3>
                <h4>{studyType}{area ? ` · ${area}` : ""}</h4>
              </div>
              <date>{Years}</date>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  li + li {
    border-top: 1px solid var(--border);
  }

  article {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
  }

  li:first-child article {
    padding-top: 0;
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  h3 {
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  h3 a {
    color: var(--ink);
    transition: color 0.15s ease-out;
  }

  h3 a:hover {
    color: var(--accent);
  }

  h4 {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--ink-secondary);
  }
</style>
