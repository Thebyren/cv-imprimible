---
import Section from "components/section.astro";
import { education } from "@/cv.json";
---

<Section title="Formación">
  <ul>
    {
      education.map(({ institution, url, area, studyType, startDate, endDate }) => {
        const sy = new Date(startDate).getFullYear();
        const ey = endDate ? new Date(endDate).getFullYear() : "presente";
        const range = `${sy} — ${ey}`;
        return (
          <li>
            <article>
              <div class="info">
                <h3><a href={url} target="_blank" rel="noopener">{institution}</a></h3>
                <h4>{studyType}{area ? ` · ${area}` : ""}</h4>
              </div>
              <date>{range}</date>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul { display: flex; flex-direction: column; gap: 0; }

  li + li { border-top: 1px solid var(--border); }

  article {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
  }

  li:first-child article { padding-top: 0; }

  .info { display: flex; flex-direction: column; gap: 2px; }

  h3 {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  h3 a {
    color: var(--ink);
    transition: color 0.15s;
  }

  h3 a:hover { color: var(--accent-hi); }

  h4 {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--ink-2);
  }

  @media print {
    h3 a { color: #0a0b0f; }
    li + li { border-color: rgba(10,11,15,0.1); }
  }
</style>
