---
interface Props {
  title: string
}
const { title } = Astro.props
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{ title }</title>
  </head>
  <body>
    <slot></slot>
  </body>
</html>

<style is:global>

  :root {
    --bg:          #08090d;
    --bg-card:     #0e1018;
    --bg-elevated: #141722;
    --ink:         #eef0f6;
    --ink-2:       #9aa0bc;
    --ink-3:       #444c6e;
    --accent:      #2b5cff;
    --accent-hi:   #4a78ff;
    --accent-sub:  rgba(43,92,255,0.12);
    --ok:          #1fa35c;
    --ok-sub:      rgba(31,163,92,0.12);
    --border:      rgba(238,240,246,0.07);
    --border-2:    rgba(238,240,246,0.13);
    --font:        "Archivo", system-ui, -apple-system, sans-serif;
    --mono:        ui-monospace, "Cascadia Mono", Consolas, "SF Mono", monospace;
    --r:           2px;
  }

  html {
    font-family: var(--font);
    background: var(--bg);
    color: var(--ink);
    letter-spacing: -0.015rem;
    scroll-behavior: smooth;
  }

  *::selection { background: var(--accent); color: #fff; }

  body, figure { margin: 0; padding: 0; }

  a    { text-decoration: none; color: var(--accent-hi); }
  ul   { list-style: none; margin: 0; padding: 0; }
  *, *::before, *::after { box-sizing: border-box; }

  h1,h2,h3,h4 { margin: 0; font-family: var(--font); color: var(--ink); }

  p {
    color: var(--ink-2);
    font-size: 0.85rem;
    line-height: 1.65;
    margin: 0;
    text-wrap: pretty;
  }

  date {
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-hi);
    background: var(--accent-sub);
    padding: 2px 9px;
    border-radius: var(--r);
    white-space: nowrap;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.3; }
  }

  /* ── PRINT RESET ─────────────────────────────────── */
  @media print {
    :root {
      --bg:          #fff;
      --bg-card:     #fff;
      --bg-elevated: #fff;
      --ink:         #0a0b0f;
      --ink-2:       #4a4f60;
      --ink-3:       #7a8090;
      --accent:      #1a3ecc;
      --accent-hi:   #1a3ecc;
      --accent-sub:  rgba(26,62,204,0.07);
      --border:      rgba(10,11,15,0.12);
      --border-2:    rgba(10,11,15,0.20);
      --ok:          #157a44;
      --ok-sub:      rgba(21,122,68,0.08);
    }
    html { background: #fff; }
    a    { color: var(--ink-2); }
    date { background: none; border: 1px solid var(--border-2); }
  }

</style>
